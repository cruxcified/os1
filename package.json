{
  "name": "os1",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore 'src/**' --ignore 'data/**' server/index.ts",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -b",
    "test": "node --import tsx --test server/**/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:main": "esbuild desktop/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-electron/main.mjs",
    "desktop": "npm run build:main && electron .",
    "dist:mac": "npm run build && npm run build:main && electron-builder --mac",
    "dist:win": "npm run build && npm run build:main && electron-builder --win"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "lucide-react": "^1.55.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@huggingface/transformers": "^3.8.1",
    "@ricky0123/vad-web": "^0.0.31",
    "kokoro-js": "^1.2.1",
    "onnxruntime-web": "^1.30.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "description": "A personal OS1 from Her: a hands-free voice companion with memory.",
  "author": "Will",
  "main": "dist-electron/main.mjs",
  "build": {
    "appId": "com.cruxcified.os1",
    "productName": "OS1",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "server/persona.md",
      "build/icon.png",
      "build/trayTemplate*.png",
      "package.json",
      "!**/*.map",
      "!node_modules/onnxruntime-web/dist/**",
      "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.{mjs,wasm}"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "mac": {
      "category": "public.app-category.lifestyle",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "OS1 listens so you can talk to it."
      },
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v3/{linux,win32}/**"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v3/{linux,darwin}/**"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
