# Copy to .env and fill in. Every key is optional: without ANTHROPIC_API_KEY OS1
# thinks with a local model through Ollama, and without the others it falls back
# to local (free, slower, less natural) speech models.

# --- Brain ---------------------------------------------------------------
ANTHROPIC_API_KEY=
# OS1_BRAIN=local                  # claude or local (default: claude if there's a key, otherwise local)
# OS1_LOCAL_MODEL=gemma3:12b       # any Ollama model; gemma3:4b for smaller laptops
# OLLAMA_HOST=127.0.0.1:11434
# OS1_MODEL=claude-opus-5-5        # try claude-haiku-5-5 for the snappiest, cheapest replies
# OS1_EFFORT=low                   # low | medium | high (higher = more thoughtful, slower)
# OS1_MEMORY_MODEL=claude-haiku-5-5

# --- Ears (speech-to-text) -------------------------------------------------
# Picked automatically: Deepgram if its key is set, else OpenAI, else local Whisper.
DEEPGRAM_API_KEY=
# OS1_STT=deepgram                 # deepgram | openai | local

# --- Voice (text-to-speech) ------------------------------------------------
# Picked automatically: ElevenLabs if its key is set, else OpenAI, else local Kokoro.
ELEVENLABS_API_KEY=
# OS1_TTS=elevenlabs               # elevenlabs | openai | kokoro
# OS1_VOICE=                       # defaults to a deep male voice for each provider:
#                                  #   elevenlabs: nPczCjzI2devNBz1zQrb ("Brian")
#                                  #   openai: onyx    kokoro: am_fenrir
# OS1_TTS_SPEED=1
# OS1_EXPRESSIVE=on               # ElevenLabs only: performs [laughs], [sighs], [whispers]…
# ELEVENLABS_EXPRESSIVE_MODEL=eleven_v4_turbo

# OpenAI can serve as both ears and voice with one key.
OPENAI_API_KEY=

# --- Personal ---------------------------------------------------------------
# OS1_USER_NAME=Will
# PORT=5173
# HOST=localhost                   # 0.0.0.0 to reach it from other devices (see README)
